<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="00012-01-version-to-meetings-and-courses" author="Roman_Kiryukhin">
        <addColumn tableName="group_practices">
            <column name="version" type="bigint" defaultValue="0"/>
        </addColumn>
        <addColumn tableName="individual_consultations">
            <column name="version" type="bigint" defaultValue="0"/>
        </addColumn>
        <addColumn tableName="video_courses">
            <column name="version" type="bigint" defaultValue="0"/>
        </addColumn>
        <addColumn tableName="audio_courses">
            <column name="version" type="bigint" defaultValue="0"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="group_practices">
                <column name="version"/>
            </dropColumn>
            <dropColumn tableName="individual_consultations">
                <column name="version"/>
            </dropColumn>
            <dropColumn tableName="video_courses">
                <column name="version"/>
            </dropColumn>
            <dropColumn tableName="audio_courses">
                <column name="version"/>
            </dropColumn>
        </rollback>
    </changeSet>

</databaseChangeLog>
